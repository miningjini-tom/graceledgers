# Ship the data with LF regardless of who checks it out. A CSV that arrives
# with CRLF trips naive parsers, and this file is meant to be consumed by
# other people's scripts rather than read in an editor.
*.json text eol=lf
*.csv  text eol=lf
*.md   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
