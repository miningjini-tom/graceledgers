    "field_notes": {
      "state_rate": "Verified against Tax Foundation midyear 2026 for all 51.",
      "avg_local": "Population-weighted average. Not usable for a specific address.",
      "combined": "state_rate + avg_local. AK is local-only; NJ local average is negative because of Urban Enterprise Zones.",
      "grocery": "exempt | reduced | full, for the STATE rate only.",
      "grocery_rate": "State rate on unprepared food. null where not published.",
      "grocery_flat": "true where the grocery rate is the whole tax and no local rate is added (UT, VA).",
      "grocery_local_taxable": "true where local tax still applies to food that is exempt at state level. NOT YET CROSS-VERIFIED - treat as the least reliable column here.",
      "shipping": "always | separate | varies. 'varies' means not established, not that it varies by transaction. 41 states are still 'varies'.",
      "nexus_amount": "Economic nexus sales threshold for remote sellers, USD.",
      "nexus_transactions": "Transaction-count threshold, or null where repealed. This column ages faster than any other - repeal is a national trend.",
      "nexus_logic": "'or' means either test triggers nexus."
    },
    "caveats": [
      "Averages are averages. No figure here is valid for a specific street address; local rates vary by city, county, and special district, and ZIP codes do not align with tax jurisdictions.",
      "This is not tax advice and must not be used to prepare a return. Use it to compare states, build a prototype, or sanity-check something else.",
      "Rates change during the year. Check the version date before relying on it.",
      "grocery_local_taxable has not been through independent cross-verification. Every other column has."
    ]
  },
